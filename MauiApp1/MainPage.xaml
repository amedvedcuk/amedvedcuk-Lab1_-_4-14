<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MauiApp1.Models"
             xmlns:viewmodels="clr-namespace:MauiApp1.ViewModels"
             x:Class="MauiApp1.MainPage"
             x:DataType="viewmodels:StudentViewModel"
             Title="Особистий кабінет студента">

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="14">

            <Entry Text="{Binding FullName, Mode=TwoWay}"
                   Placeholder="ПІБ студента" />

            <Entry Text="{Binding Group, Mode=TwoWay}"
                   Placeholder="Група" />

            <Label Text="{Binding AverageScore, Mode=OneWay, StringFormat='Середній бал: {0:F2}'}" />

            <Slider Minimum="0"
                    Maximum="5"
                    Value="{Binding AverageScore, Mode=TwoWay}" />

            <Label Text="{Binding SummaryText, Mode=OneWay}"
                   TextColor="{Binding ScoreIndicatorColor, Mode=OneWay}"
                   FontSize="16"
                   FontAttributes="Bold" />

            <Button Text="Додати студента"
                    Command="{Binding AddStudentCommand}" />

            <Label Text="Список студентів"
                   FontSize="18"
                   FontAttributes="Bold"
                   Margin="0,8,0,0" />

            <CollectionView ItemsSource="{Binding Students}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Student">
                        <Border Padding="10" Margin="0,4">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding FullName}" FontAttributes="Bold" />
                                <Label Text="{Binding Group, StringFormat='Група: {0}'}" />
                                <Label Text="{Binding AverageScore, StringFormat='Середній бал: {0:F2}'}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>